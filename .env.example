# Chave da API Gemini (https://aistudio.google.com/apikey)
# Também pode ser informada pela tela de Configurações da aplicação.
GEMINI_API_KEY=

# Modelo usado para ler editais (padrão: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Banco de dados Neon Postgres (provisionado automaticamente na Vercel)
# Se omitido localmente, usa fallback em data/db.json
DATABASE_URL=

# Segredo para assinar tokens de sessão (gerado automaticamente se omitido)
# AUTH_SECRET=

# Porta da API (o front em desenvolvimento roda na 5173)
# PORT=5174
