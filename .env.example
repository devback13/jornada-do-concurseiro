# Provedores de IA (também podem ser configurados individualmente pela tela de Configurações)
# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# OpenAI / ChatGPT (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.2-sol

# Anthropic / Claude (https://console.anthropic.com/settings/keys)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Bot do Telegram (opcional globalmente; cada usuário também pode configurar na tela de Configurações)
# TELEGRAM_BOT_TOKEN=

# Banco de dados Neon Postgres (provisionado automaticamente na Vercel)
# Se omitido localmente, usa fallback em data/db.json
DATABASE_URL=

# Segredo para assinar tokens de sessão (gerado automaticamente se omitido)
# AUTH_SECRET=

# Porta da API (o front em desenvolvimento roda na 5173)
# PORT=5174
